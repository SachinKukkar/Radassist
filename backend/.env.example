# Copy this file to .env and adjust values. Never commit .env.
# The dependency values below match compose.yaml's services published on localhost.

# --- Application ---
RADASSIST_ENVIRONMENT=development
RADASSIST_DEBUG=false
RADASSIST_LOG_LEVEL=INFO
RADASSIST_LOG_JSON=false

# --- PostgreSQL ---
RADASSIST_DATABASE_URL=postgresql://radassist:radassist@localhost:5432/radassist

# --- Redis ---
RADASSIST_REDIS_URL=redis://localhost:6379/0

# --- S3-compatible object storage ---
RADASSIST_S3_ENDPOINT_URL=http://localhost:8333
RADASSIST_S3_REGION=us-east-1
RADASSIST_S3_ACCESS_KEY=radassist
RADASSIST_S3_SECRET_KEY=radassist-dev-secret
RADASSIST_S3_BUCKET=radassist-images

# --- Health checks ---
RADASSIST_HEALTH_CHECK_TIMEOUT_SECONDS=2
